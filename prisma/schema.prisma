generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id         Int       @id @default(autoincrement())
  name       String
  brand      String?
  warehouseName String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  categoryId Int
  tenantId   Int?
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tenant     Tenant?   @relation(fields: [tenantId], references: [id])
  variants   Variant[]
  purchaseOrderItems PurchaseOrderItem[]

  @@index([tenantId])
  @@index([createdAt])
  @@index([name])
  @@index([categoryId])
  @@index([warehouseName])
}

model Category {
  id          Int         @id @default(autoincrement())
  tenantId    Int?
  name        String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  catalogType CatalogType
  isActive    Boolean     @default(true)
  config      Json?
  tenant      Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  products    Product[]

  @@unique([tenantId, name])
  @@index([name])
  @@index([catalogType])
  @@index([tenantId])
  @@index([isActive])
}

model Variant {
  id             Int             @id @default(autoincrement())
  productId      Int
  size           String
  color          String
  variantIdentityKey String?
  stock          Int             @default(0)
  reorderLevel   Int?
  createdAt      DateTime        @default(now())
  price          Decimal         @db.Decimal(10, 2)
  costPrice      Decimal         @default(0) @db.Decimal(10, 2)
  updatedAt      DateTime        @updatedAt
  sku            String?         @unique
  barcode        String?         @unique
  imagePath      String?
  material       String?
  powerWatts     String?
  locationCode   String?
  customAttributes Json?
  tenantId       Int?
  orders         Order[]
  items          OrderItem[]
  inventories    VariantInventory[]
  inventoryCountLines InventoryCountLine[]
  stockMovements StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant         Tenant?         @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([productId])
  @@unique([productId, variantIdentityKey])
  @@index([productId, size])
  @@index([productId, color])
  @@index([stock])
  @@index([createdAt])
}

model Warehouse {
  id          Int                @id @default(autoincrement())
  tenantId    Int
  name        String
  slug        String
  isActive    Boolean            @default(true)
  supportsPos Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  inventories VariantInventory[]
  orders      Order[]
  orderItems  OrderItem[]
  purchaseOrders PurchaseOrder[]
  inventoryCounts InventoryCountSession[]
  stockMovements StockMovement[]
  auditLogs   AuditLog[]
  posRegisters PosRegister[]
  posSessions  PosSession[]
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([isActive])
  @@index([supportsPos])
}

model VariantInventory {
  id           Int       @id @default(autoincrement())
  variantId     Int
  warehouseId   Int
  stock         Int       @default(0)
  locationCode  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  variant       Variant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([variantId, warehouseId])
  @@index([warehouseId])
  @@index([stock])
}

model StockMovement {
    id        Int                 @id @default(autoincrement())
    variantId Int
    warehouseId Int?
    quantity  Int
    reason    StockMovementReason
    createdAt DateTime            @default(now())
    tenantId  Int?
    tenant    Tenant?             @relation(fields: [tenantId], references: [id])
    variant   Variant             @relation(fields: [variantId], references: [id], onDelete: Cascade)
    warehouse Warehouse?          @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

    @@index([tenantId])
    @@index([variantId])
    @@index([warehouseId])
    @@index([createdAt])
    @@index([reason])
  }

model Order {
    id           Int         @id @default(autoincrement())
    phone        String
    quantity     Int?
    variantId    Int?
    warehouseId  Int?
    posSessionId Int?
    subtotal     Decimal     @default(0) @db.Decimal(10, 2)
    discountType PosDiscountType?
    discountValue Decimal    @default(0) @db.Decimal(10, 2)
    discountAmount Decimal   @default(0) @db.Decimal(10, 2)
    createdAt    DateTime    @default(now())
    customerName String
  instagram    String?
  notes        String?
  status       OrderStatus @default(NEW)
  updatedAt    DateTime    @updatedAt
    source       OrderSource @default(INSTAGRAM)
    tenantId     Int?
    tenant       Tenant?     @relation(fields: [tenantId], references: [id])
    variant      Variant?    @relation(fields: [variantId], references: [id])
    warehouse    Warehouse?  @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  posSession   PosSession? @relation(fields: [posSessionId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  posPayments  PosPayment[]

  @@index([tenantId])
  @@index([createdAt])
    @@index([status])
    @@index([source])
    @@index([variantId])
    @@index([warehouseId])
    @@index([posSessionId])
  }

model OrderItem {
    id        Int      @id @default(autoincrement())
    orderId   Int
    variantId Int
    warehouseId Int?
    quantity  Int
    returnedQuantity Int @default(0)
    unitPrice Decimal  @db.Decimal(10, 2)
    unitCost  Decimal  @default(0) @db.Decimal(10, 2)
    createdAt DateTime @default(now())
    order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
    variant   Variant  @relation(fields: [variantId], references: [id])
    warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

    @@index([orderId])
    @@index([variantId])
    @@index([warehouseId])
  }

model User {
  id           Int                @id @default(autoincrement())
  name         String
  email        String             @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  sessions     Session[]
  memberships  TenantMembership[]
  auditLogs    AuditLog[]
  createdInventoryCounts InventoryCountSession[] @relation("InventoryCountCreatedBy")
  completedInventoryCounts InventoryCountSession[] @relation("InventoryCountCompletedBy")
  createdPurchaseOrders PurchaseOrder[] @relation("PurchaseOrderCreatedBy")
  openedPosSessions PosSession[] @relation("PosSessionOpenedBy")
  closedPosSessions PosSession[] @relation("PosSessionClosedBy")
  posCashMovements PosCashMovement[] @relation("PosCashMovementCreatedBy")
}

model Session {
  id             Int      @id @default(autoincrement())
  token          String   @unique
  userId         Int
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  activeTenantId Int?
  activeTenant   Tenant?  @relation(fields: [activeTenantId], references: [id])
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([activeTenantId])
  @@index([expiresAt])
}

model Tenant {
  id             Int                @id @default(autoincrement())
  name           String
  slug           String             @unique
  status         TenantStatus       @default(ACTIVE)
  catalogType    CatalogType
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  orders         Order[]
  products       Product[]
    sessions       Session[]
    stockMovements StockMovement[]
    subscription   Subscription?
    memberships    TenantMembership[]
    settings       TenantSettings?
    categories     Category[]
    variants       Variant[]
    warehouses     Warehouse[]
    suppliers      Supplier[]
    purchaseOrders PurchaseOrder[]
    auditLogs      AuditLog[]
    inventoryCounts InventoryCountSession[]
    posRegisters   PosRegister[]
    posSessions    PosSession[]
    posPayments    PosPayment[]
    posCashMovements PosCashMovement[]

    @@index([status])
    @@index([catalogType])
  }

model PosRegister {
  id          Int          @id @default(autoincrement())
  tenantId    Int
  warehouseId Int
  name        String
  slug        String
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  sessions    PosSession[]

  @@unique([tenantId, slug])
  @@unique([warehouseId, name])
  @@index([tenantId])
  @@index([warehouseId])
  @@index([isActive])
}

model PosSession {
  id             Int              @id @default(autoincrement())
  tenantId       Int
  registerId     Int
  warehouseId    Int
  openedById     Int
  closedById     Int?
  status         PosSessionStatus @default(OPEN)
  openingCash    Decimal          @db.Decimal(10, 2)
  openingNote    String?
  closingNote    String?
  openedAt       DateTime         @default(now())
  closedAt       DateTime?
  expectedCash   Decimal?         @db.Decimal(10, 2)
  countedCash    Decimal?         @db.Decimal(10, 2)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  register       PosRegister      @relation(fields: [registerId], references: [id], onDelete: Cascade)
  warehouse      Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  openedBy       User             @relation("PosSessionOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  closedBy       User?            @relation("PosSessionClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  orders         Order[]
  payments       PosPayment[]
  cashMovements  PosCashMovement[]

  @@index([tenantId])
  @@index([registerId])
  @@index([warehouseId])
  @@index([openedById])
  @@index([closedById])
  @@index([status])
  @@index([openedAt])
  @@index([closedAt])
}

model PosPayment {
  id           Int              @id @default(autoincrement())
  tenantId     Int
  posSessionId Int
  orderId      Int
  method       PosPaymentMethod
  amount       Decimal          @db.Decimal(10, 2)
  createdAt    DateTime         @default(now())
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  posSession   PosSession       @relation(fields: [posSessionId], references: [id], onDelete: Cascade)
  order        Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([posSessionId])
  @@index([orderId])
  @@index([method])
  @@index([createdAt])
}

model PosCashMovement {
  id           Int                 @id @default(autoincrement())
  tenantId     Int
  posSessionId Int
  createdById  Int
  type         PosCashMovementType
  amount       Decimal             @db.Decimal(10, 2)
  note         String?
  createdAt    DateTime            @default(now())
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  posSession   PosSession          @relation(fields: [posSessionId], references: [id], onDelete: Cascade)
  createdBy    User                @relation("PosCashMovementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([posSessionId])
  @@index([createdById])
  @@index([type])
  @@index([createdAt])
}

model AuditLog {
  id          Int       @id @default(autoincrement())
  tenantId    Int
  userId      Int?
  action      String
  entityType  String
  entityId    Int?
  entityLabel String?
  warehouseId Int?
  metadata    Json?
  createdAt   DateTime  @default(now())
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([warehouseId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

model InventoryCountSession {
  id            Int                  @id @default(autoincrement())
  tenantId      Int
  warehouseId   Int
  status        InventoryCountStatus @default(OPEN)
  note          String?
  createdById   Int?
  completedById Int?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  completedAt   DateTime?
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse     Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  createdBy     User?                @relation("InventoryCountCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  completedBy   User?                @relation("InventoryCountCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  lines         InventoryCountLine[]

  @@index([tenantId])
  @@index([warehouseId])
  @@index([status])
  @@index([createdAt])
}

model InventoryCountLine {
  id            Int                   @id @default(autoincrement())
  sessionId     Int
  variantId     Int
  expectedStock Int
  countedStock  Int?
  difference    Int?
  locationCode  String?
  note          String?
  countedAt     DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  session       InventoryCountSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  variant       Variant               @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([sessionId, variantId])
  @@index([sessionId])
  @@index([variantId])
}

model TenantMembership {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  userId    Int
  role      UserRole
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
}

model Subscription {
  id                 Int                @id @default(autoincrement())
  tenantId           Int                @unique
  planCode           String?
  status             SubscriptionStatus @default(TRIALING)
  trialStart         DateTime?
  trialEnd           DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  providerCustomerId String?
  providerSubId      String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status])
}

model TenantSettings {
  id           Int      @id @default(autoincrement())
  tenantId     Int      @unique
  businessName String?
  logoUrl      String?
  primaryColor String?
  currency     String   @default("EUR")
  language     String   @default("sq")
  catalogConfig Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Supplier {
  id        Int      @id @default(autoincrement())
  tenantId   Int
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([isActive])
  @@index([createdAt])
}

model PurchaseOrder {
  id          Int                 @id @default(autoincrement())
  tenantId    Int
  supplierId  Int
  warehouseId Int
  status      PurchaseOrderStatus @default(ORDERED)
  note        String?
  orderedAt   DateTime            @default(now())
  createdById Int?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier    Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse   Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy   User?               @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items       PurchaseOrderItem[]

  @@index([tenantId])
  @@index([supplierId])
  @@index([warehouseId])
  @@index([status])
  @@index([orderedAt])
  @@index([createdAt])
}

model PurchaseOrderItem {
  id              Int           @id @default(autoincrement())
  purchaseOrderId Int
  productId       Int?
  variantId       Int?
  orderedQuantity Int
  receivedQuantity Int         @default(0)
  returnedQuantity Int         @default(0)
  unitCost        Decimal       @db.Decimal(10, 2)
  note            String?
  pendingProductName String?
  pendingBrand    String?
  pendingCategoryName String?
  pendingColor    String?
  pendingSize     String?
  pendingMaterial String?
  pendingPowerWatts String?
  pendingVariantIdentityKey String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product?      @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant         Variant?      @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@index([productId])
  @@index([variantId])
}

enum OrderStatus {
  NEW
  READY
  DONE
  PARTIALLY_RETURNED
  CANCELED
  RETURNED
}

enum OrderSource {
  INSTAGRAM
  STORE
  WHOLESALE
}

enum UserRole {
  SUPER_ADMIN
  SELLER
  WAREHOUSE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIALING
  EXPIRED
}

enum CatalogType {
  FOOTWEAR
  ELECTRONICS
  HOME_GOODS
  DECOR
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum InventoryCountStatus {
  OPEN
  COMPLETED
}

enum StockMovementReason {
  INCOMING_STOCK
  POS_SALE
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  TRANSFER
  INVENTORY_COUNT
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  PARTIALLY_RETURNED
  RETURNED
  CANCELED
}

enum PosSessionStatus {
  OPEN
  CLOSED
}

enum PosPaymentMethod {
  CASH
  CARD
}

enum PosDiscountType {
  PERCENT
  FIXED
}

enum PosCashMovementType {
  CASH_IN
  CASH_OUT
}
